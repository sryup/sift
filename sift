#!/bin/sh
set -u

VERSION="0.2.1"

show_help() {
    cat << 'EOF'
Usage: sift [OPTIONS]

A lightweight, portable Linux system information tool.

Options:
  -h, --help       Show this help message and exit
  -v, --version    Show version information and exit
      --no-color   Disable ANSI color output
EOF
}

show_version() {
    printf 'sift %s\n' "$VERSION"
}

init_colors() {
    c_reset=""
    c_host=""
    c_branch=""
    c_label=""

    # 1. User specified --no-color
    if [ "$opt_no_color" -eq 1 ]; then
        return 0
    fi

    # 2. Output is not an interactive terminal
    if [ ! -t 1 ]; then
        return 0
    fi

    # 3. NO_COLOR environment variable is set and non-empty
    if [ -n "${NO_COLOR:-}" ]; then
        return 0
    fi

    # 4. Terminal type is dumb
    if [ "${TERM:-}" = "dumb" ]; then
        return 0
    fi

    c_reset=$(printf '\033[0m')
    c_host=$(printf '\033[1;32m')
    c_branch=$(printf '\033[90m')
    c_label=$(printf '\033[1;32m')
}

print_header() {
    printf '%s%s%s (%s)\n' "$c_host" "$1" "$c_reset" "$2"
}

print_branch() {
    printf '%s%s%s %s%-7s%s %s\n' "$c_branch" "$1" "$c_reset" "$c_label" "$2" "$c_reset" "$3"
}

parse_os_val() {
    raw="$1"
    case "$raw" in
        '"'*'"')
            inner="${raw%\"}"
            inner="${inner#\"}"

            # Check if trailing quote was escaped (odd number of trailing backslashes)
            trailing_bs=""
            tmp="$inner"
            while [ "${tmp%\\}" != "$tmp" ]; do
                trailing_bs="${trailing_bs}\\"
                tmp="${tmp%\\}"
            done
            len=${#trailing_bs}
            if [ $((len % 2)) -ne 0 ]; then
                return 0
            fi

            unescaped=""
            while :; do
                case "$inner" in
                    *\\*)
                        prefix="${inner%%\\*}"
                        rest="${inner#*\\}"
                        char="${rest%"${rest#?}"}"
                        inner="${rest#?}"
                        case "$char" in
                            '"' | "\\" | '$' | '`')
                                unescaped="${unescaped}${prefix}${char}"
                                ;;
                            *)
                                unescaped="${unescaped}${prefix}\\${char}"
                                ;;
                        esac
                        ;;
                    *)
                        unescaped="${unescaped}${inner}"
                        break
                        ;;
                esac
            done
            printf '%s' "$unescaped"
            ;;
        "'"*"'")
            inner="${raw%\'}"
            inner="${inner#\'}"
            printf '%s' "$inner"
            ;;
        *[\'\"]* | *'`'* | *\$*)
            # Contains unclosed/illegal quotes or expansions -> invalid
            ;;
        *)
            printf '%s' "$raw"
            ;;
    esac
}

get_os() {
    os_name=""
    os_pretty=""
    os_fallback=""

    if [ -f /etc/os-release ] && [ -r /etc/os-release ]; then
        while IFS='=' read -r key val || [ -n "${key:-}" ]; do
            case "$key" in
                ""|\#*) continue ;;
                PRETTY_NAME)
                    parsed=$(parse_os_val "$val")
                    [ -n "$parsed" ] && os_pretty="$parsed"
                    ;;
                NAME)
                    parsed=$(parse_os_val "$val")
                    [ -n "$parsed" ] && os_fallback="$parsed"
                    ;;
            esac
        done < /etc/os-release 2>/dev/null
    fi

    if [ -n "$os_pretty" ]; then
        os_name="$os_pretty"
    elif [ -n "$os_fallback" ]; then
        os_name="$os_fallback"
    fi

    if [ -z "$os_name" ]; then
        os_name=$(uname -s 2>/dev/null || echo "")
        [ -z "$os_name" ] && os_name="N/A"
    fi

    if [ "$os_name" != "N/A" ]; then
        arch=$(uname -m 2>/dev/null || echo "")
        if [ -n "$arch" ]; then
            os_name="$os_name $arch"
        fi
    fi

    printf '%s' "$os_name"
}

get_host() {
    host_name=""
    if [ -f /proc/sys/kernel/hostname ] && [ -r /proc/sys/kernel/hostname ]; then
        read -r host_name < /proc/sys/kernel/hostname 2>/dev/null || host_name=""
    fi

    if [ -z "$host_name" ]; then
        host_name=$(uname -n 2>/dev/null || echo "")
    fi

    [ -z "$host_name" ] && host_name="N/A"
    printf '%s' "$host_name"
}

get_kernel() {
    kernel_name=$(uname -r 2>/dev/null || echo "")
    [ -z "$kernel_name" ] && kernel_name="N/A"
    printf '%s' "$kernel_name"
}

get_uptime() {
    uptime_str="N/A"

    if [ -f /proc/uptime ] && [ -r /proc/uptime ]; then
        raw_up=""
        if read -r raw_up _ < /proc/uptime 2>/dev/null && [ -n "${raw_up:-}" ]; then
            valid_num=0
            case "$raw_up" in
                *.*)
                    sec="${raw_up%%.*}"
                    frac="${raw_up#*.}"
                    case "$sec" in "" | *[!0-9]*) ;; *)
                        case "$frac" in "" | *[!0-9]*) ;; *)
                            valid_num=1
                            ;;
                        esac
                        ;;
                    esac
                    ;;
                *)
                    sec="$raw_up"
                    case "$sec" in "" | *[!0-9]*) ;; *)
                        valid_num=1
                        ;;
                    esac
                    ;;
            esac

            if [ "$valid_num" -eq 1 ]; then
                while [ "$sec" != "${sec#0}" ] && [ "$sec" != "0" ]; do
                    sec="${sec#0}"
                done

                # Bound check: max 2147483647
                within_bound=1
                if [ "${#sec}" -gt 10 ]; then
                    within_bound=0
                elif [ "${#sec}" -eq 10 ]; then
                    sec_prefix="${sec%?????}"
                    if [ "$sec_prefix" -gt 21474 ]; then
                        within_bound=0
                    elif [ "$sec_prefix" -eq 21474 ]; then
                        sec_suffix="${sec#?????}"
                        while [ "$sec_suffix" != "${sec_suffix#0}" ] && [ "$sec_suffix" != "0" ]; do
                            sec_suffix="${sec_suffix#0}"
                        done
                        if [ "$sec_suffix" -gt 83647 ]; then
                            within_bound=0
                        fi
                    fi
                fi

                if [ "$within_bound" -eq 1 ]; then
                    days=$((sec / 86400))
                    rem=$((sec % 86400))
                    hours=$((rem / 3600))
                    rem=$((rem % 3600))
                    mins=$((rem / 60))

                    if [ "$days" -gt 0 ]; then
                        uptime_str="${days}d ${hours}h ${mins}m"
                    elif [ "$hours" -gt 0 ]; then
                        uptime_str="${hours}h ${mins}m"
                    elif [ "$mins" -gt 0 ]; then
                        uptime_str="${mins}m"
                    else
                        uptime_str="0m"
                    fi
                fi
            fi
        fi
    fi

    printf '%s' "$uptime_str"
}

valid_float() {
    case "$1" in
        *.*)
            _int="${1%%.*}"
            _frac="${1#*.}"
            case "$_int" in "" | *[!0-9]*) return 1 ;; esac
            case "$_frac" in "" | *[!0-9]*) return 1 ;; esac
            ;;
        *)
            case "$1" in "" | *[!0-9]*) return 1 ;; esac
            ;;
    esac
    return 0
}

get_cpu() {
    cpu_model=""
    cpu_count=0

    if [ -f /proc/cpuinfo ] && [ -r /proc/cpuinfo ]; then
        while IFS=':' read -r key val || [ -n "${key:-}" ]; do
            k="${key#"${key%%[! 	]*}"}"
            k="${k%"${k##*[! 	]}"}"
            case "$k" in
                "model name")
                    if [ -z "$cpu_model" ]; then
                        v="${val#"${val%%[! 	]*}"}"
                        v="${v%"${v##*[! 	]}"}"
                        [ -n "$v" ] && cpu_model="$v"
                    fi
                    ;;
                "processor")
                    v="${val#"${val%%[! 	]*}"}"
                    v="${v%"${v##*[! 	]}"}"
                    case "$v" in
                        "" | *[!0-9]*) ;;
                        *) cpu_count=$((cpu_count + 1)) ;;
                    esac
                    ;;
            esac
        done < /proc/cpuinfo 2>/dev/null
    fi

    if [ -z "$cpu_model" ]; then
        arch=$(uname -m 2>/dev/null || echo "")
        if [ -n "$arch" ]; then
            cpu_model="$arch Processor"
        else
            cpu_model="N/A"
        fi
    fi

    if [ "$cpu_count" -gt 0 ]; then
        count_str="$cpu_count"
    else
        count_str="N/A"
    fi

    if [ "$cpu_model" = "N/A" ] && [ "$count_str" = "N/A" ]; then
        printf 'N/A'
    else
        printf '%s (%s)' "$cpu_model" "$count_str"
    fi
}

get_load() {
    load_str="N/A"

    if [ -f /proc/loadavg ] && [ -r /proc/loadavg ]; then
        if read -r l1 l5 l15 _ < /proc/loadavg 2>/dev/null && [ -n "${l1:-}" ] && [ -n "${l5:-}" ] && [ -n "${l15:-}" ]; then
            if valid_float "$l1" && valid_float "$l5" && valid_float "$l15"; then
                load_str="${l1}, ${l5}, ${l15}"
            fi
        fi
    fi

    printf '%s' "$load_str"
}

get_memory() {
    mem_total=""
    mem_avail=""

    if [ -f /proc/meminfo ] && [ -r /proc/meminfo ]; then
        while read -r key val _ || [ -n "${key:-}" ]; do
            case "$key" in
                MemTotal:)
                    case "$val" in
                        "" | *[!0-9]*) ;;
                        *) mem_total="$val" ;;
                    esac
                    ;;
                MemAvailable:)
                    case "$val" in
                        "" | *[!0-9]*) ;;
                        *) mem_avail="$val" ;;
                    esac
                    ;;
            esac
        done < /proc/meminfo 2>/dev/null
    fi

    if [ -z "$mem_total" ] || [ "$mem_total" -le 0 ] 2>/dev/null; then
        printf 'N/A'
        return 0
    fi

    avail_valid=0
    if [ -n "$mem_avail" ]; then
        case "$mem_avail" in
            *[!0-9]*) ;;
            *)
                if [ "$mem_avail" -ge 0 ] 2>/dev/null && [ "$mem_avail" -le "$mem_total" ] 2>/dev/null; then
                    avail_valid=1
                fi
                ;;
        esac
    fi

    if [ "$avail_valid" -eq 1 ]; then
        LC_ALL=C awk -v t="$mem_total" -v a="$mem_avail" 'BEGIN {
            u = t - a
            pct = (t > 0) ? (u / t) * 100 : 0
            if (t >= 1048576) { t_s = sprintf("%.1f GiB", t / 1048576) }
            else { t_s = sprintf("%.1f MiB", t / 1024) }
            if (u >= 1048576) { u_s = sprintf("%.1f GiB", u / 1048576) }
            else { u_s = sprintf("%.1f MiB", u / 1024) }
            printf "%s / %s (%.0f%%)", u_s, t_s, pct
        }'
    else
        LC_ALL=C awk -v t="$mem_total" 'BEGIN {
            if (t >= 1048576) { t_s = sprintf("%.1f GiB", t / 1048576) }
            else { t_s = sprintf("%.1f MiB", t / 1024) }
            printf "N/A / %s (N/A)", t_s
        }'
    fi
}

read_temperature_attr() {
    [ -f "$1" ] && [ -r "$1" ] || return 1
    temp_attr=""
    # Redirect stderr first so disappearing sysfs attributes stay quiet.
    IFS= read -r temp_attr 2>/dev/null < "$1" || [ -n "$temp_attr" ] || return 1
    [ -n "$temp_attr" ] || return 1
    printf '%s' "$temp_attr"
}

get_temperature() (
    # An internal path argument lets tests supply a sysfs fixture tree.
    temp_class=${1:-/sys/class}
    temperature=$(
        # Prefer hwmon labels when the same reading also has a thermal zone.
        for sensor in \
            "$temp_class"/hwmon/hwmon*/temp*_input \
            "$temp_class"/thermal/thermal_zone*/temp
        do
            temp_dir=${sensor%/*}
            temp_id=${temp_dir##*/}
            case "$sensor" in
                */temp*_input)
                    temp_base=${sensor%_input}
                    temp_channel=${temp_base##*/}
                    # Missing flags are optional; unreadable or invalid flags
                    # cannot establish that a sensor is healthy and enabled.
                    for temp_flag in fault enable; do
                        temp_flag_file=${temp_base}_${temp_flag}
                        if [ -e "$temp_flag_file" ] || [ -L "$temp_flag_file" ]; then
                            temp_state=$(read_temperature_attr "$temp_flag_file") || continue 2
                            case "$temp_flag:$temp_state" in
                                fault:0|enable:1) ;;
                                *) continue 2 ;;
                            esac
                        fi
                    done
                    temp_device=$(read_temperature_attr "$temp_dir/name") || temp_device="$temp_id"
                    # VT1211 external channels require board-specific scaling;
                    # only temp2 is already a temperature in millidegrees Celsius.
                    case "$temp_device:$temp_channel" in
                        vt1211:temp2) ;;
                        vt1211:*) continue ;;
                    esac
                    temp_label=$(read_temperature_attr "${temp_base}_label") || temp_label="$temp_channel"
                    temp_source="$temp_device / $temp_label"
                    ;;
                *)
                    # Thermal zone mode controls kernel thermal management,
                    # not whether a readable temperature is a valid sample.
                    temp_type=$(read_temperature_attr "$temp_dir/type") || temp_type=""
                    temp_source="$temp_id"
                    [ -z "$temp_type" ] || temp_source="$temp_type / $temp_id"
                    ;;
            esac
            temp_raw=$(read_temperature_attr "$sensor") || continue
            case "${temp_raw#-}" in
                ""|*[!0-9]*) continue ;;
            esac
            printf '%s\t%s\n' "$temp_raw" "$temp_source"
        done | LC_ALL=C awk -F '\t' '
            $1 ~ /^-?[0-9][0-9]*$/ {
                value = $1 + 0
                # Sanity bounds, not operating limits: zero and negatives are
                # valid. Alarm/critical thresholds do not indicate a bad sensor.
                if (value >= -273150 && value <= 300000 && (!found || value > hottest)) {
                    hottest = value
                    source = substr($0, index($0, "\t") + 1)
                    gsub(/[[:cntrl:]]/, "?", source)
                    found = 1
                }
            }
            END {
                if (found) {
                    printf "%.1f °C (max: %s)", hottest / 1000, source
                }
            }
        '
    )

    if [ -n "$temperature" ]; then
        printf '%s' "$temperature"
    else
        printf 'N/A'
    fi
)

get_disk() {
    df_out=""
    df_out=$(df -P -k / 2>/dev/null) || df_out=""

    if [ -z "$df_out" ]; then
        printf 'N/A'
        return 0
    fi

    parsed=$(LC_ALL=C printf '%s\n' "$df_out" | LC_ALL=C awk '
        NR == 2 {
            if (NF >= 6) {
                tot = $(NF-4)
                usd = $(NF-3)
                pct = $(NF-1)
                if (tot ~ /^[0-9]+$/ && usd ~ /^[0-9]+$/ && pct ~ /^[0-9]+%$/ && tot > 0) {
                    if (tot >= 1048576) { t_s = sprintf("%.1f GiB", tot / 1048576) }
                    else { t_s = sprintf("%.1f MiB", tot / 1024) }
                    if (usd >= 1048576) { u_s = sprintf("%.1f GiB", usd / 1048576) }
                    else { u_s = sprintf("%.1f MiB", usd / 1024) }
                    printf "%s / %s (%s)", u_s, t_s, pct
                    ok = 1
                    exit 0
                }
            }
        }
        END { if (!ok) exit 1 }
    ') || parsed=""

    if [ -n "$parsed" ]; then
        printf '%s' "$parsed"
    else
        printf 'N/A'
    fi
}

# Parse and validate all CLI arguments
opt_help=0
opt_version=0
opt_no_color=0

for arg do
    case "$arg" in
        -h|--help)
            opt_help=1
            ;;
        -v|--version)
            opt_version=1
            ;;
        --no-color)
            opt_no_color=1
            ;;
        *)
            printf "sift: unrecognized option '%s'\n" "$arg" >&2
            printf "Try 'sift --help' for more information.\n" >&2
            exit 2
            ;;
    esac
done

# Precedence: --help has higher priority than --version
if [ "$opt_help" -eq 1 ]; then
    show_help
    exit 0
fi

if [ "$opt_version" -eq 1 ]; then
    show_version
    exit 0
fi

# Ensure running on Linux operating system
os_kernel=$(uname -s 2>/dev/null || echo "")
if [ "$os_kernel" != "Linux" ]; then
    printf 'sift: error: unsupported operating system (Linux required)\n' >&2
    exit 1
fi

# Initialize terminal colors based on environment and options
init_colors

# Collect and display system snapshot
print_header "$(get_host)" "$(get_os)"
print_branch "├─" "kernel" "$(get_kernel)"
print_branch "├─" "uptime" "$(get_uptime)"
print_branch "├─" "cpu"    "$(get_cpu)"
print_branch "├─" "load"   "$(get_load)"
print_branch "├─" "memory" "$(get_memory)"
print_branch "├─" "temp"   "$(get_temperature /sys/class)"
print_branch "└─" "disk"   "$(get_disk)"

exit 0

